#!/usr/bin/env bash
# Runs a heavy local job (full test suite, build, e2e) so that only a few run at once on this Mac, across
# every worktree of the repository. Waiters queue first in, first out.
#
# Usage:
#   infra/dev/heavy [--lane heavy|medium] [--label TEXT] [--wait MIN] [--max MIN] -- COMMAND [ARGS...]
#   infra/dev/heavy --status
#
#   --lane   heavy (1 job at a time, the default) or medium (2 at a time)
#   --label  name shown in --status and in the waiting lines (default: the command's basename)
#   --wait   give up after MIN minutes in the queue, exit 75 (default 60)
#   --max    kill the command's process group after MIN minutes, exit 124 (default 40)
#
# Exit codes: the command's own code; 64 usage; 75 gave up waiting; 124 run timeout; 130 INT; 143 TERM.
#
# State lives in <git common dir>/idraft-locks/<lane>/: slot-N directories taken with mkdir, and a
# tickets/ directory with one file per waiter. Environment, for the self-test only:
#   IDRAFT_LOCK_ROOT   state root (default: <git common dir>/idraft-locks)
#   IDRAFT_HEALTH_DIR  where the health watcher keeps pause and state (default /tmp/idraft-health)
#   IDRAFT_HEAVY_POLL  seconds between polls, fractions allowed (default 5)
#   IDRAFT_HEAVY_UNIT  seconds per "minute" of --wait, --max and the progress line (default 60)
#   IDRAFT_HEAVY_GRACE seconds between TERM and KILL of the command's process group (default 10)
set -euo pipefail

say() { printf 'heavy: %s\n' "$*" >&2; }
die_usage() {
  say "$*"
  say "usage: infra/dev/heavy [--lane heavy|medium] [--label TEXT] [--wait MIN] [--max MIN] -- COMMAND [ARGS...] | --status"
  exit 64
}

is_uint() { case "$1" in '' | *[!0-9]*) return 1 ;; *) return 0 ;; esac; }
is_num() { # digits with at most one inner dot: 5, 0.2
  case "$1" in '' | *[!0-9.]* | .* | *. | *.*.*) return 1 ;; *) return 0 ;; esac
}
now_ns() { perl -MTime::HiRes=gettimeofday -e '($s, $u) = gettimeofday; printf "%d%06d000\n", $s, $u'; }
fmt_dur() { # fmt_dur SECONDS -> 3m12s
  local s="$1"
  [ "$s" -ge 0 ] || s=0
  printf '%dm%02ds' $((s / 60)) $((s % 60))
}
field() { # field FILE KEY: the value of the first KEY= line, nothing if the file or the key is missing
  local line
  [ -r "$1" ] || return 0
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in "$2="*) printf '%s\n' "${line#*=}"; return 0 ;; esac
  done <"$1"
}

# ---- options ----

lane=heavy label="" wait_min=60 max_min=40 want_status=0 have_cmd=0
while [ "$#" -gt 0 ]; do
  case "$1" in
    --lane | --label | --wait | --max)
      [ "$#" -ge 2 ] || die_usage "missing value for $1"
      case "$1" in
        --lane) lane="$2" ;;
        --label) label="$2" ;;
        --wait) wait_min="$2" ;;
        --max) max_min="$2" ;;
      esac
      shift 2
      ;;
    --status) want_status=1; shift ;;
    --) shift; have_cmd=1; break ;;
    *) die_usage "unknown option: $1" ;;
  esac
done

poll="${IDRAFT_HEAVY_POLL:-5}" unit="${IDRAFT_HEAVY_UNIT:-60}" grace="${IDRAFT_HEAVY_GRACE:-10}"
is_num "$poll" || die_usage "IDRAFT_HEAVY_POLL must be a number of seconds, got '$poll'"
is_uint "$unit" && [ "$unit" -ge 1 ] || die_usage "IDRAFT_HEAVY_UNIT must be an integer >= 1"
is_uint "$grace" || die_usage "IDRAFT_HEAVY_GRACE must be an integer >= 0"

if [ -n "${IDRAFT_LOCK_ROOT:-}" ]; then
  root="$IDRAFT_LOCK_ROOT"
else
  common="$(git rev-parse --path-format=absolute --git-common-dir 2>/dev/null)" ||
    die_usage "not in a git repository and IDRAFT_LOCK_ROOT is not set"
  root="$common/idraft-locks"
fi

lane_slots() { case "$1" in heavy) echo 1 ;; medium) echo 2 ;; esac; }

# ---- status (read only) ----

status_lane() { # status_lane LANE
  local l="$1" dir slots n=1 held=0 o t name tpid k=0 now started
  dir="$root/$l"
  slots="$(lane_slots "$l")"
  now="$(date +%s)"
  while [ "$n" -le "$slots" ]; do
    if [ -d "$dir/slot-$n" ]; then
      held=1
      o="$dir/slot-$n/owner"
      started="$(field "$o" start)"
      printf '%s: slot-%s pid %s label %s worktree %s running %s cmd %s\n' "$l" "$n" \
        "$(field "$o" pid)" "$(field "$o" label)" "$(field "$o" worktree)" \
        "$(fmt_dur $((now - ${started:-$now})))" "$(field "$o" cmd)"
    fi
    n=$((n + 1))
  done
  [ "$held" -eq 1 ] || printf '%s: idle\n' "$l"
  for t in "$dir/tickets"/*; do
    [ -f "$t" ] || continue
    name="${t##*/}"
    tpid="${name#*-}"
    kill -0 "$tpid" 2>/dev/null || continue
    k=$((k + 1))
    printf '%s: queue %s: pid %s label %s waiting %s\n' "$l" "$k" "$tpid" "$(field "$t" label)" \
      "$(fmt_dur $((now - ${name%%-*} / 1000000000)))"
  done
}

if [ "$want_status" -eq 1 ]; then
  status_lane heavy
  status_lane medium
  exit 0
fi

# ---- validation of a run ----

[ "$have_cmd" -eq 1 ] || die_usage "missing -- before the command"
if [ "$#" -eq 0 ] || [ -z "$1" ]; then die_usage "empty command"; fi
case "$lane" in heavy | medium) ;; *) die_usage "--lane must be heavy or medium, got '$lane'" ;; esac
is_uint "$wait_min" || die_usage "--wait must be an integer >= 0, got '$wait_min'"
is_uint "$max_min" && [ "$max_min" -ge 1 ] || die_usage "--max must be an integer >= 1, got '$max_min'"
wait_min=$((10#$wait_min))
max_min=$((10#$max_min))
[ -n "$label" ] || label="${1##*/}"
label="${label//$'\n'/ }"

slots="$(lane_slots "$lane")"
lane_dir="$root/$lane"
worktree="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cmdline="$(printf '%q ' "$@")"
cmdline="${cmdline% }"

# ---- slot logic ----

my_ns="$(now_ns)"
ticket_name="$my_ns-$$"
ticket="$lane_dir/tickets/$ticket_name"
marker="$lane_dir/.timeout-$$"
held="" child="" pgid="" watchdog="" ahead=0 free=0 run_start=0

# shellcheck disable=SC2329  # runs from the EXIT trap and from on_signal
cleanup() {
  # The watchdog must not outlive us: it would write a stale marker and kill a recycled process group.
  [ -z "$watchdog" ] || kill -TERM -- "-$watchdog" 2>/dev/null || true
  rm -f "$ticket" "$lane_dir/tickets/.new-$$" "$marker"
  # Only a slot that still says it is ours: a slot reaped and taken by someone else stays.
  if [ -n "$held" ] && [ "$(field "$held/owner" pid)" = "$$" ]; then
    rm -rf "$held"
  elif [ -n "$held" ] && [ ! -e "$held/owner" ]; then
    # Stopped between mkdir and the first owner file.
    rm -f "$held/owner.tmp"
    rmdir "$held" 2>/dev/null || true
  fi
  return 0
}

# TERM the command's process group, give it the grace period, then KILL what is left.
finish_group() {
  local end
  end=$(($(date +%s) + grace))
  while kill -0 -- "-$pgid" 2>/dev/null && [ "$(date +%s)" -lt "$end" ]; do sleep 0.1; done
  if kill -0 -- "-$pgid" 2>/dev/null; then kill -KILL -- "-$pgid" 2>/dev/null || true; fi
}
# shellcheck disable=SC2329  # runs from on_signal
stop_group() {
  [ -n "$child" ] || return 0
  kill -TERM -- "-$pgid" 2>/dev/null || true
  finish_group
}
# shellcheck disable=SC2329  # runs from the HUP, INT and TERM traps
on_signal() { # on_signal EXIT_CODE
  trap '' HUP INT TERM
  [ -z "$watchdog" ] || kill -TERM -- "-$watchdog" 2>/dev/null || true
  stop_group
  cleanup
  exit "$1"
}

write_owner() { # write_owner PGID: tmp file then rename, so a reader never sees half an owner file
  printf 'pid=%s\npgid=%s\nlabel=%s\nworktree=%s\ncmd=%s\nstart=%s\n' \
    "$$" "$1" "$label" "$worktree" "$cmdline" "$run_start" >"$held/owner.tmp"
  mv "$held/owner.tmp" "$held/owner"
}

# Rank and free slots, from live tickets only. Sets ahead (live tickets older than ours) and free.
survey() {
  local t name tns tpid n=1
  ahead=0
  free=0
  while [ "$n" -le "$slots" ]; do
    [ -d "$lane_dir/slot-$n" ] || free=$((free + 1))
    n=$((n + 1))
  done
  for t in "$lane_dir/tickets"/*; do
    [ -f "$t" ] || continue
    name="${t##*/}"
    [ "$name" != "$ticket_name" ] || continue
    tns="${name%%-*}"
    tpid="${name#*-}"
    is_uint "$tns" || continue
    is_uint "$tpid" || continue
    kill -0 "$tpid" 2>/dev/null || continue
    if [ "$((10#$tns))" -lt "$((10#$my_ns))" ] || { [ "$tns" = "$my_ns" ] && [ "$tpid" -lt "$$" ]; }; then
      ahead=$((ahead + 1))
    fi
  done
}

claim() { # first free slot wins; mkdir is the atomic step
  local n=1
  while [ "$n" -le "$slots" ]; do
    if mkdir "$lane_dir/slot-$n" 2>/dev/null; then
      held="$lane_dir/slot-$n"
      return 0
    fi
    n=$((n + 1))
  done
  return 1
}

progress_line() {
  local n=1 hl="$label" hp="$$" hs="" now o
  now="$(date +%s)"
  while [ "$n" -le "$slots" ]; do
    o="$lane_dir/slot-$n/owner"
    if [ -r "$o" ]; then
      hl="$(field "$o" label)"
      hp="$(field "$o" pid)"
      hs="$(field "$o" start)"
      break
    fi
    n=$((n + 1))
  done
  say "waiting for $hl (pid $hp, $(fmt_dur $((now - ${hs:-$now})))), $ahead ahead"
}

# Task 2 fills these in: the stale sweep and the pause check.
sweep_stale() { :; }
pause_active() { return 1; }

mkdir -p "$lane_dir/tickets"
trap cleanup EXIT
trap 'on_signal 129' HUP
trap 'on_signal 130' INT
trap 'on_signal 143' TERM

# The ticket exists before the first poll, so a later arrival can never overtake us.
printf 'label=%s\nworktree=%s\n' "$label" "$worktree" >"$lane_dir/tickets/.new-$$"
mv "$lane_dir/tickets/.new-$$" "$ticket"

wait_start="$(date +%s)"
deadline=$((wait_start + wait_min * unit))
last_note="$wait_start"
while :; do
  # Read the clock before the claim, so the owner file needs no fork after mkdir.
  now="$(date +%s)"
  sweep_stale
  paused=0
  if pause_active; then paused=1; fi
  survey
  if [ "$paused" -eq 0 ] && [ "$ahead" -lt "$free" ] && claim; then break; fi
  if [ "$now" -ge "$deadline" ]; then
    say "gave up after ${wait_min}m waiting for $lane"
    exit 75
  fi
  if [ $((now - last_note)) -ge "$unit" ]; then
    progress_line
    last_note="$now"
  fi
  sleep "$poll"
done

# The owner file is written before the ticket goes, so --status never shows a job in neither place.
run_start="$now"
write_owner ""
rm -f "$ticket"
# A marker left by an earlier wrapper with the same pid would read as a run timeout.
rm -f "$marker"

# Job control makes each background job a process group of its own, so pgid is the child's pid and a group
# kill reaches its grandchildren. The command never reads the terminal (a background group that does is
# stopped), and it is run as "$@": no eval, no re-splitting of arguments.
set -m
"$@" </dev/null &
child=$!
pgid="$child"
(
  sleep $((max_min * unit))
  : >"$marker"
  kill -TERM -- "-$pgid" 2>/dev/null || true
  sleep "$grace"
  kill -KILL -- "-$pgid" 2>/dev/null || true
) &
watchdog=$!
set +m
write_owner "$pgid"

rc=0
wait "$child" 2>/dev/null || rc=$?
{ kill -TERM -- "-$watchdog"; wait "$watchdog"; } 2>/dev/null || true
watchdog=""
if [ -e "$marker" ]; then
  finish_group
  rc=124
fi
child=""
exit "$rc"
