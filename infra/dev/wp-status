#!/usr/bin/env bash
# Writes the progress line of one work package where the coordinator reads it, and prints the line.
#
# Usage: infra/dev/wp-status WP-NN <status> "<note>" [--rows N/T] [--tasks N/T] [--blockers TEXT] [--next TEXT]
#
#   status      planning, building, review, blocked, merged or idle
#   --rows      rows done as N/T (default $WP_ROWS, else ?/?)
#   --tasks     plan tasks done as N/T (default $WP_TASKS, else ?/?)
#   --blockers  what blocks the package (default $WP_BLOCKERS, else none)
#   --next      the next step (default $WP_NEXT, else the note)
#
# Prints, and writes as line 1 of <git common dir>/ai-visibility/status/WP-NN.txt:
#   WP-NN <status> | branch <branch> @ <sha> | rows done <n>/<t> | tasks <n>/<t> | blockers: <list> | next: <text>
# Line 2 of the file is note=<note>, line 3 is at=<time>. The file lives outside git and is shared by every
# worktree of the repository. Branch and sha are those of the current worktree. Exit 64 on bad usage.
set -euo pipefail

usage='usage: infra/dev/wp-status WP-NN <planning|building|review|blocked|merged|idle> "<note>" [--rows N/T] [--tasks N/T] [--blockers TEXT] [--next TEXT]'
die_usage() { printf 'wp-status: %s\n%s\n' "$1" "$usage" >&2; exit 64; }
die() { printf 'wp-status: %s\n' "$*" >&2; exit 1; }
# One line, no field separator: newlines become spaces and a pipe becomes a slash.
clean() { printf '%s' "$1" | tr '\n\r|' '  /'; }

rows="${WP_ROWS:-}" tasks="${WP_TASKS:-}" blockers="${WP_BLOCKERS:-}" next="${WP_NEXT:-}"
n=0 id="" status="" note=""
while [ "$#" -gt 0 ]; do
  case "$1" in
    --rows | --tasks | --blockers | --next)
      [ "$#" -ge 2 ] || die_usage "missing value for $1"
      case "$1" in
        --rows) rows="$2" ;;
        --tasks) tasks="$2" ;;
        --blockers) blockers="$2" ;;
        --next) next="$2" ;;
      esac
      shift 2
      ;;
    --*) die_usage "unknown option: $1" ;;
    *)
      n=$((n + 1))
      case "$n" in
        1) id="$1" ;;
        2) status="$1" ;;
        3) note="$1" ;;
        *) die_usage "too many arguments" ;;
      esac
      shift
      ;;
  esac
done
[ "$n" -eq 3 ] || die_usage "expected WP-NN, a status and a note"

id_re='^WP-[0-9][0-9]$'
count_re='^[0-9]+/[0-9]+$'
[[ $id =~ $id_re ]] || die_usage "work package id must look like WP-07, got '$id'"
case "$status" in
  planning | building | review | blocked | merged | idle) ;;
  *) die_usage "unknown status '$status'" ;;
esac
case "$note" in *[![:space:]]*) ;; *) die_usage "the note is empty" ;; esac
[ -z "$rows" ] || [[ $rows =~ $count_re ]] || die_usage "rows must look like 3/10, got '$rows'"
[ -z "$tasks" ] || [[ $tasks =~ $count_re ]] || die_usage "tasks must look like 2/5, got '$tasks'"

note="$(clean "$note")"
blockers="$(clean "${blockers:-none}")"
next="$(clean "${next:-$note}")"
rows="${rows:-?/?}" tasks="${tasks:-?/?}"

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null)" || die "not in a git repository with a commit"
sha="$(git rev-parse --short HEAD)"
common="$(git rev-parse --path-format=absolute --git-common-dir)"
branch="$(clean "$branch")"

line="$id $status | branch $branch @ $sha | rows done $rows | tasks $tasks | blockers: $blockers | next: $next"
dir="$common/ai-visibility/status"
mkdir -p "$dir"
tmp="$dir/$id.txt.tmp.$$"
trap 'rm -f "$tmp"' EXIT
printf '%s\nnote=%s\nat=%s\n' "$line" "$note" "$(date +%Y-%m-%dT%H:%M:%S%z)" >"$tmp"
mv -f "$tmp" "$dir/$id.txt"
printf '%s\n' "$line"
