#!/usr/bin/env bash
# Stages the platform environment file from stdin as /etc/idraft/.env.next (root:root, 0600).
# Installed by bootstrap.sh as /usr/local/sbin/idraft-install-env and the only way the deploy user
# writes env files (a sudoers rule allows exactly this command). It never prints the contents.
# deploy.sh validates .env.next, deploys with it and promotes it to .env only once the release serves,
# so a bad env can never replace the one the serving release runs on.
set -euo pipefail

target="/etc/idraft/.env.next"

if [ "$(id -u)" -ne 0 ]; then
  echo "idraft-install-env must run as root (through sudo)." >&2
  exit 1
fi

umask 077
tmp="$(mktemp /etc/idraft/.env.next.XXXXXX)"
trap 'rm -f "$tmp"' EXIT

# The same directory as the target, so the final mv is a rename and never a half-written file.
cat > "$tmp"
if [ ! -s "$tmp" ]; then
  echo "Refusing an empty environment file." >&2
  exit 1
fi
chown root:root "$tmp"
chmod 0600 "$tmp"
mv -f "$tmp" "$target"
echo "Staged $target."
