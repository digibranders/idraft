[Unit]
Description=idraft web
After=network.target idraft-api.service

[Service]
User=idraft
Group=idraft
WorkingDirectory=/srv/idraft/web
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=HOSTNAME=127.0.0.1
Environment=PORT=3010
# The API is on 8010: another project on this host holds 127.0.0.1:8000.
Environment=API_INTERNAL_ORIGIN=http://127.0.0.1:8010
ExecStart=/opt/node/bin/node apps/web/server.js
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
