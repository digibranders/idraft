[Unit]
Description=idraft API
After=network.target postgresql@18-main.service redis-server@idraft.service
Wants=postgresql@18-main.service redis-server@idraft.service

[Service]
User=idraft
Group=idraft
WorkingDirectory=/srv/idraft/backend
EnvironmentFile=/etc/idraft/api.env
Environment=PYTHONUNBUFFERED=1
# 8010, not 8000: another project on this host holds 127.0.0.1:8000.
ExecStart=/srv/idraft/backend/.venv/bin/uvicorn idraft.api.main:create_app --factory --host=127.0.0.1 --port=8010 --proxy-headers --no-access-log --no-server-header --timeout-graceful-shutdown=25
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
