[Unit]
Description=idraft worker
After=network.target postgresql@18-main.service redis-server@idraft.service
Wants=postgresql@18-main.service redis-server@idraft.service

[Service]
User=idraft
Group=idraft
WorkingDirectory=/srv/idraft/backend
EnvironmentFile=/etc/idraft/worker.env
Environment=PYTHONUNBUFFERED=1
# The worker touches HEARTBEAT_FILE (/run/idraft-worker/heartbeat) while it is healthy; infra/vps/activate.sh reads it.
RuntimeDirectory=idraft-worker
ExecStart=/srv/idraft/backend/.venv/bin/python -m idraft.worker
Restart=always
RestartSec=3
LimitNOFILE=65535
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full

[Install]
WantedBy=multi-user.target
