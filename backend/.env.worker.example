# Local development values for the worker and its commands. Copy to .env.worker; nothing here
# protects anything real. The worker connects as app_worker, which works across workspaces.
PROCESS_ROLE=worker
APP_ENV=local
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://app_worker:worker-dev@127.0.0.1:54329/sightline
REDIS_URL=redis://127.0.0.1:63799/0
# Optional. With DataForSEO credentials the worker also needs the raw payload bucket:
#   DATAFORSEO_LOGIN=, DATAFORSEO_PASSWORD=
#   R2_RAW_ENDPOINT=, R2_RAW_ACCESS_KEY_ID=, R2_RAW_SECRET_ACCESS_KEY=, R2_RAW_BUCKET=seo-raw
