{
  "components": {
    "schemas": {
      "Accepted": {
        "description": "The request was taken. The answer is the same whether or not the address has an account.",
        "properties": {
          "status": {
            "const": "accepted",
            "default": "accepted",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Accepted",
        "type": "object"
      },
      "Done": {
        "properties": {
          "status": {
            "const": "ok",
            "default": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "title": "Done",
        "type": "object"
      },
      "EmailRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "EmailRequest",
        "type": "object"
      },
      "Health": {
        "properties": {
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "Health",
        "type": "object"
      },
      "Me": {
        "properties": {
          "memberships": {
            "items": {
              "$ref": "#/components/schemas/MeMembership"
            },
            "title": "Memberships",
            "type": "array"
          },
          "session": {
            "$ref": "#/components/schemas/MeSession"
          },
          "user": {
            "$ref": "#/components/schemas/MeUser"
          }
        },
        "required": [
          "user",
          "session",
          "memberships"
        ],
        "title": "Me",
        "type": "object"
      },
      "MeMembership": {
        "properties": {
          "permissions": {
            "items": {
              "type": "string"
            },
            "title": "Permissions",
            "type": "array"
          },
          "project_ids": {
            "anyOf": [
              {
                "items": {
                  "format": "uuid",
                  "type": "string"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "description": "null means every project",
            "title": "Project Ids"
          },
          "role": {
            "$ref": "#/components/schemas/Role"
          },
          "workspace": {
            "$ref": "#/components/schemas/MeWorkspace"
          }
        },
        "required": [
          "workspace",
          "role",
          "project_ids",
          "permissions"
        ],
        "title": "MeMembership",
        "type": "object"
      },
      "MeResponse": {
        "properties": {
          "data": {
            "$ref": "#/components/schemas/Me"
          }
        },
        "required": [
          "data"
        ],
        "title": "MeResponse",
        "type": "object"
      },
      "MeSession": {
        "properties": {
          "auth_method": {
            "const": "session",
            "default": "session",
            "title": "Auth Method",
            "type": "string"
          },
          "expires_at": {
            "format": "date-time",
            "title": "Expires At",
            "type": "string"
          },
          "fresh_until": {
            "anyOf": [
              {
                "format": "date-time",
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Fresh Until"
          }
        },
        "required": [
          "fresh_until",
          "expires_at"
        ],
        "title": "MeSession",
        "type": "object"
      },
      "MeUser": {
        "properties": {
          "created_at": {
            "format": "date-time",
            "title": "Created At",
            "type": "string"
          },
          "email": {
            "title": "Email",
            "type": "string"
          },
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "image": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Image"
          },
          "name": {
            "title": "Name",
            "type": "string"
          },
          "two_factor_enabled": {
            "title": "Two Factor Enabled",
            "type": "boolean"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "name",
          "email",
          "email_verified",
          "image",
          "two_factor_enabled",
          "created_at"
        ],
        "title": "MeUser",
        "type": "object"
      },
      "MeWorkspace": {
        "properties": {
          "name": {
            "title": "Name",
            "type": "string"
          },
          "slug": {
            "title": "Slug",
            "type": "string"
          },
          "status": {
            "enum": [
              "active",
              "suspended",
              "deleting"
            ],
            "title": "Status",
            "type": "string"
          },
          "workspace_id": {
            "format": "uuid",
            "title": "Workspace Id",
            "type": "string"
          }
        },
        "required": [
          "workspace_id",
          "name",
          "slug",
          "status"
        ],
        "title": "MeWorkspace",
        "type": "object"
      },
      "Problem": {
        "additionalProperties": true,
        "description": "The body of every error response. Codes may add members, documented per route.",
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "detail": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Detail"
          },
          "errors": {
            "anyOf": [
              {
                "items": {
                  "$ref": "#/components/schemas/ValidationItem"
                },
                "type": "array"
              },
              {
                "type": "null"
              }
            ],
            "default": null,
            "title": "Errors"
          },
          "instance": {
            "title": "Instance",
            "type": "string"
          },
          "request_id": {
            "title": "Request Id",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "integer"
          },
          "title": {
            "title": "Title",
            "type": "string"
          },
          "type": {
            "title": "Type",
            "type": "string"
          }
        },
        "required": [
          "type",
          "title",
          "status",
          "instance",
          "code",
          "request_id"
        ],
        "title": "Problem",
        "type": "object"
      },
      "Readiness": {
        "properties": {
          "checks": {
            "$ref": "#/components/schemas/ReadinessChecks"
          },
          "status": {
            "enum": [
              "ready",
              "not_ready"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "checks"
        ],
        "title": "Readiness",
        "type": "object"
      },
      "ReadinessChecks": {
        "properties": {
          "migrations": {
            "title": "Migrations",
            "type": "boolean"
          },
          "postgres": {
            "title": "Postgres",
            "type": "boolean"
          },
          "redis": {
            "title": "Redis",
            "type": "boolean"
          }
        },
        "required": [
          "postgres",
          "redis",
          "migrations"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      },
      "RegisterRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "invitation_token": {
            "anyOf": [
              {
                "maxLength": 128,
                "minLength": 1,
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "description": "From an invitation link. Required while registration is by invitation only.",
            "title": "Invitation Token"
          },
          "name": {
            "maxLength": 120,
            "minLength": 1,
            "title": "Name",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "name",
          "email",
          "password"
        ],
        "title": "RegisterRequest",
        "type": "object"
      },
      "RegisterResponse": {
        "properties": {
          "email_verified": {
            "title": "Email Verified",
            "type": "boolean"
          },
          "user_id": {
            "format": "uuid",
            "title": "User Id",
            "type": "string"
          }
        },
        "required": [
          "user_id",
          "email_verified"
        ],
        "title": "RegisterResponse",
        "type": "object"
      },
      "Role": {
        "enum": [
          "owner",
          "admin",
          "editor",
          "analyst",
          "viewer",
          "billing"
        ],
        "title": "Role",
        "type": "string"
      },
      "SignInRequest": {
        "additionalProperties": false,
        "properties": {
          "email": {
            "maxLength": 254,
            "minLength": 3,
            "title": "Email",
            "type": "string"
          },
          "password": {
            "maxLength": 1024,
            "title": "Password",
            "type": "string"
          }
        },
        "required": [
          "email",
          "password"
        ],
        "title": "SignInRequest",
        "type": "object"
      },
      "SignInResponse": {
        "properties": {
          "status": {
            "enum": [
              "signed_in",
              "totp_required"
            ],
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status"
        ],
        "title": "SignInResponse",
        "type": "object"
      },
      "ValidationItem": {
        "properties": {
          "code": {
            "title": "Code",
            "type": "string"
          },
          "location": {
            "title": "Location",
            "type": "string"
          },
          "message": {
            "title": "Message",
            "type": "string"
          },
          "path": {
            "title": "Path",
            "type": "string"
          }
        },
        "required": [
          "location",
          "path",
          "code",
          "message"
        ],
        "title": "ValidationItem",
        "type": "object"
      },
      "VerifyEmailRequest": {
        "additionalProperties": false,
        "properties": {
          "token": {
            "maxLength": 128,
            "minLength": 1,
            "title": "Token",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyEmailRequest",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sightline API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/api/healthz": {
      "get": {
        "operationId": "healthz_api_healthz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Health"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "Liveness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/readyz": {
      "get": {
        "operationId": "readyz_api_readyz_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Successful Response"
          },
          "503": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Readiness"
                }
              }
            },
            "description": "Service Unavailable"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "Readiness",
        "tags": [
          "health"
        ]
      }
    },
    "/api/v1/auth/register": {
      "post": {
        "description": "While registration is by invitation, `invitation_token` is required.",
        "operationId": "register_api_v1_auth_register_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/RegisterResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "Create an account",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-in": {
      "post": {
        "description": "Sets the session cookie. `totp_required` means the session can only call `/auth/totp/verify` until a code is accepted.",
        "operationId": "sign_in_api_v1_auth_sign_in_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/SignInRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/SignInResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "Sign in with email and password",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/sign-out": {
      "post": {
        "description": "Always clears the cookie, whether or not it named a live session.",
        "operationId": "sign_out_api_v1_auth_sign_out_post",
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "End the session",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/verify-email": {
      "post": {
        "operationId": "verify_email_api_v1_auth_verify_email_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyEmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Done"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "Confirm an email address with the emailed token",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/auth/verify-email/request": {
      "post": {
        "description": "Answers 202 whether or not the address has an account.",
        "operationId": "request_email_verification_api_v1_auth_verify_email_request_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/EmailRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "202": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Accepted"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "Send a new verification email",
        "tags": [
          "auth"
        ]
      }
    },
    "/api/v1/me": {
      "get": {
        "operationId": "me_api_v1_me_get",
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeResponse"
                }
              }
            },
            "description": "Successful Response"
          },
          "default": {
            "content": {
              "application/problem+json": {
                "schema": {
                  "$ref": "#/components/schemas/Problem"
                }
              }
            },
            "description": "Error, as RFC 9457 problem details. `code` is the stable machine value."
          }
        },
        "summary": "The signed-in user, this session and their workspaces",
        "tags": [
          "auth"
        ]
      }
    }
  }
}
