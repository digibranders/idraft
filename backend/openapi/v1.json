          },
          "postgres": {
            "title": "Postgres",
            "type": "boolean"
          },
          "redis": {
            "title": "Redis",
            "type": "boolean"
          }
        },
        "required": [
          "postgres",
          "redis",
          "migrations"
        ],
        "title": "ReadinessChecks",
        "type": "object"
      }
    }
  },
  "info": {
    "title": "Sightline API",
    "version": "0.1.0"
  },
