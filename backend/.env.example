# Local development values. Copy to .env; nothing here protects anything real.
# The API connects as app_api, which is subject to row-level security.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://app_api:api-dev@127.0.0.1:54329/idraft
REDIS_URL=redis://127.0.0.1:63799/0
# Encrypts TOTP secrets at rest. This value is for local development only; production uses its own:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# Wraps the data key of stored credentials (Google refresh tokens). Local development value only;
# production uses its own, and never changes it once a Google account is connected.
SECRETS_ENCRYPTION_KEY=ICEiIyQlJicoKSorLC0uLzAxMjM0NTY3ODk6Ozw9Pj8=
# Optional. The defaults suit local work:
#   REGISTRATION=invited          invited (accounts need an invitation) or open
#   EMAIL_PROVIDER=console        console prints emails to stderr; resend needs EMAIL_API_KEY and an EMAIL_FROM on your domain
#   BREACHED_PASSWORD_CHECK=true  false skips the Pwned Passwords lookup (for working offline)

# The bearer token of GET /api/internal/health, the full health report (at least 24 characters).
# Without it the route does not exist. Generate one: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   HEALTH_TOKEN=

# Connecting Google (Search Console). Both or neither; the redirect address to register with the
# OAuth client is APP_ORIGIN + /api/v1/oauth/google/callback, for example
# http://localhost:3000/api/v1/oauth/google/callback. Never commit the values.
#   GOOGLE_OAUTH_CLIENT_ID=
#   GOOGLE_OAUTH_CLIENT_SECRET=
