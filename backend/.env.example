# Local development values. Copy to .env; nothing here protects anything real.
# The API connects as app_api, which is subject to row-level security.
APP_ENV=local
APP_ORIGIN=http://localhost:3000
LOG_LEVEL=debug
DATABASE_URL=postgresql://app_api:api-dev@127.0.0.1:54329/sightline
REDIS_URL=redis://127.0.0.1:63799/0
# Encrypts TOTP secrets at rest. This value is for local development only; production uses its own:
#   python -c "import base64, os; print(base64.b64encode(os.urandom(32)).decode())"
TOTP_ENCRYPTION_KEY=AAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8=
# Optional. The defaults suit local work:
#   REGISTRATION=invited          invited (accounts need an invitation) or open
#   EMAIL_PROVIDER=console        console prints emails to stderr; resend needs EMAIL_API_KEY and an EMAIL_FROM on your domain
#   BREACHED_PASSWORD_CHECK=true  false skips the Pwned Passwords lookup (for working offline)
