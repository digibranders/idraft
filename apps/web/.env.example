# Copy to .env.local for local development. Every variable is validated by src/lib/env.ts.

# production, development or test. Inlined when the app is built.
NEXT_PUBLIC_APP_ENV=development

# off: every request reaches the API. pending: only endpoints the API does not have yet are mocked.
# all: no API is needed. Must be off in production.
NEXT_PUBLIC_API_MOCKING=off

# The image tag (git SHA). Inlined when the app is built.
NEXT_PUBLIC_RELEASE=dev

# Origin of the API for server components: scheme, host and port, no path. Required in production
# (http://api:8000 in Compose). Defaults to http://127.0.0.1:8000 in development and tests.
API_INTERNAL_ORIGIN=http://127.0.0.1:8000

# Development only. When set, the dev server sends /api/* to this origin, so the browser talks to the
# real API on the app's own origin.
API_PROXY_TARGET=
