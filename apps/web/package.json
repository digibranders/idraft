{
  "name": "@app/web",
  "private": true,
  "type": "module",
  "description": "Web application (Next.js). The static design preview in design-preview/ stays as the visual reference until every page it shows is ported.",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "node scripts/prepare-standalone.mjs && node .next/standalone/apps/web/server.js",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "gen:api": "openapi-typescript ../../backend/openapi/v1.json -o src/lib/api/schema.d.ts",
    "preview": "node design-preview/icons.mjs && node design-preview/vendor.mjs && node design-preview/core-modules.mjs && tailwindcss -i design-preview/preview.css -o design-preview/preview.compiled.css"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@lobehub/icons-static-svg": "1.95.1",
    "@next/eslint-plugin-next": "^16.3.7",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/culori": "^4.0.1",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "culori": "^4.0.2",
    "eslint": "^10.11.0",
    "eslint-plugin-better-tailwindcss": "^4.7.0",
    "eslint-plugin-boundaries": "^7.2.0",
    "eslint-plugin-i18next": "^6.1.5",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "jsdom": "^30.1.1",
    "lucide-static": "1.48.0",
    "msw": "^2.15.0",
    "openapi-typescript": "^7.13.0",
    "postcss": "^8.5.28",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.70.1",
    "vitest": "^5.0.2",
    "vitest-axe": "^0.1.0"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@date-fns/tz": "^1.5.0",
    "@hookform/resolvers": "^5.9.1",
    "@tanstack/react-query": "^5.104.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "echarts": "6.1.0",
    "geist": "^1.7.2",
    "lucide-react": "1.48.0",
    "next": "^16.3.7",
    "next-intl": "^4.14.8",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.1",
    "openapi-fetch": "^0.17.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-hook-form": "^7.89.0",
    "tailwind-merge": "^3.7.0",
    "uqr": "^0.1.3",
    "zod": "^4.6.5"
  }
}
